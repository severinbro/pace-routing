FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends dbus && rm -rf /var/lib/apt/lists/*
COPY requirements-web.txt /app/
RUN pip install --no-cache-dir -r requirements-web.txt
COPY . /app/
RUN PACE_DEBUG=true python manage.py collectstatic --noinput
EXPOSE 8000
CMD ["sh", "-c", "python manage.py migrate --noinput && gunicorn pace.wsgi:application --bind 0.0.0.0:8000 --workers 2 --threads 2 --timeout 120"]
