# Container data path, bound to ./data in the project folder.
DATA_ROOT=/data

# Verified camera mapping: index 0 is left; index 1 is right.
LEFT_CAMERA_INDEX=0
RIGHT_CAMERA_INDEX=1

# Video capture settings
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_BITRATE=12000000
CLIP_DURATION_SECONDS=60

# Optional extra rpicam-vid arguments, for example --awb indoor --shutter 10000 --gain 2.
CAMERA_COMMON_ARGS=
LEFT_CAMERA_ARGS=
RIGHT_CAMERA_ARGS=

# Adafruit BNO085 on I2C; UTC and monotonic host timestamps are recorded.
IMU_ENABLED=true
IMU_I2C_BUS=1
IMU_ADDRESS=0x4a
IMU_INTERVAL_SECONDS=0.05

# BH1750 ambient illuminance; optional and non-blocking when absent.
LIGHT_ENABLED=true
LIGHT_I2C_BUS=1
LIGHT_ADDRESS=0x23
LIGHT_INTERVAL_SECONDS=0.2

# Extract one JPEG pair per interval; decimal values such as 0.5 are supported.
FRAME_INTERVAL_SECONDS=1
JPEG_QUALITY=2
# Rotate extracted JPEG frames to match camera mounting orientation (0 or 180).
IMAGE_ROTATION=180

# Thermal Master P2 Pro USB 0bda:5830; one selected thermal sample per stereo pair.
THERMAL_ENABLED=true
THERMAL_DEVICE=/dev/v4l/by-id/usb-Generic_USB_Camera_200901010001-video-index0
# Fixed Celsius scale for color thermal previews; values outside this range are clamped.
THERMAL_COLOR_MIN_C=0
THERMAL_COLOR_MAX_C=60

# SENSE receiver (TLS name must match the SENSE server certificate).
SENSE_UPLOAD_HOST=pace-sense.local
SENSE_TLS_NAME=pace-sense.local
SENSE_HTTPS_PORT=443
SENSE_CA_FILE=/run/secrets/sense-ca.crt
SENSE_TOKEN_FILE=/run/secrets/halo-upload-token
SENSE_UPLOAD_TIMEOUT_SECONDS=600
UPLOAD_SCAN_SECONDS=10
UPLOAD_INCLUDE_VIDEO=false

# Pause capture at this session limit to protect the SD card.
MAX_LOCAL_SESSIONS=10
RETRY_DELAY_SECONDS=10

