# PostgreSQL (must match SENSE/compose.yaml healthcheck user/db)
POSTGRES_DB=pace
POSTGRES_USER=pace
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Django web app (pace-web)
PACE_DB_NAME=pace
PACE_DB_USER=pace
PACE_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
PACE_DB_HOST=pace-db
PACE_DJANGO_SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY
PACE_DEBUG=false
PACE_ALLOWED_HOSTS=10.42.10.1,pace-sense.local,localhost,127.0.0.1
PACE_SECURE_COOKIES=true
HALO_ENABLED=true
HALO_DASHBOARD_URL=http://dashboard:8080
HALO_INTERNAL_TOKEN_FILE=/config/dashboard-internal.token
SENSE_HARDWARE_AVAILABLE=false

# Optional Django overrides (container paths)
# PACE_REDIS_HOST=redis
# PACE_CSRF_TRUSTED_ORIGINS=https://example.local
# SENSE_DATA_DIR=/data
# OFFLINE_MBTILES_PATH=/data/maps/offline.mbtiles
# Keep phone clock sync disabled if the host uses its own time source.
# PACE_PHONE_CLOCK_SYNC=false
