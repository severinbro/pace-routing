# Local test ports; bound to this machine only.
# On PACE Wi-Fi, bind HTTPS to the SENSE hotspot IP instead:
# SENSE_HTTPS_PORT=10.42.10.1:8000
SENSE_HTTPS_PORT=127.0.0.1:8000
SENSE_HTTP_PORT=127.0.0.1:18080
PACE_UID=1000
PACE_GID=1000
PACE_DATA_DIR=./data
# Required: replace <halo-user> with the account used by the dashboard SSH key.
HALO_SSH_TARGET=<halo-user>@10.42.10.2

# Optional compose.segmentation.yaml, relative to the SENSE Compose directory.
SEGMENTATION_ADMISSION_ENABLED=false
SEGMENTATION_MODEL_DIR=./models/deployed
# SEGMENTATION_PENDING_MAX_FRAMES=256
# SEGMENTATION_PENDING_MAX_BYTES=2147483648
# SEGMENTATION_LIVE_MAX_BYTES=4294967296
# SEGMENTATION_FRAME_ARTIFACT_MAX_BYTES=1048576
