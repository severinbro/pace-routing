# Local test ports; bound to this machine only.
# On PACE Wi-Fi, bind HTTPS to the SENSE hotspot IP instead:
# SENSE_HTTPS_PORT=10.42.10.1:8000
SENSE_HTTPS_PORT=127.0.0.1:8000
SENSE_HTTP_PORT=127.0.0.1:18080
PACE_UID=1000
PACE_GID=1000
PACE_DATA_DIR=./data
# Required: replace <halo-user> with the account used by the dashboard SSH key.
HALO_SSH_TARGET=<halo-user>@10.42.10.2
